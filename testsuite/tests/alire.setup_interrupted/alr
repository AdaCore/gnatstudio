#!/bin/bash
# Fake 'alr' executable: the real one needs the network and a toolchain.
#
# Like the real 'alr' it refuses to run when handed an argument it does not know
# about; the offending command line is then left behind in 'bad_command_line'
# for the driver to report. Every accepted invocation is appended to 'alr_runs'.
#
# 'build' stands for the long synchronization of a fresh crate: it does not
# return until the test driver creates the 'sync_may_finish' file. The driver
# interrupts the setup while it is waiting, which must terminate this script:
# 'sync_interrupted' is then left behind, whereas 'sync_gave_up' says that we
# were left running and gave up on our own after 30 seconds.

cmd=""

for arg in "$@"; do
    case "$arg" in
        --non-interactive|--no-color|--no-tty|-q|--stop-after=generation) ;;
        build|show|printenv) cmd="$arg" ;;
        *)
            echo "unexpected argument: $arg" >&2
            printf 'alr %s\n' "$*" > bad_command_line
            exit 1
            ;;
    esac
done

echo "$cmd" >> alr_runs

case "$cmd" in
    build)
        echo "Synchronizing the crate..."
        trap 'touch sync_interrupted; exit 130' INT TERM HUP
        touch sync_started

        # Give up after 30 seconds rather than hang the testsuite.
        for _ in $(seq 300); do
            if [ -f sync_may_finish ]; then
                echo "Build finished successfully."
                touch sync_finished
                exit 0
            fi
            sleep 0.1
        done

        echo "Timed out waiting for the test driver."
        touch sync_gave_up
        exit 1
        ;;

    show)
        echo "  Name: hello"
        echo "  Project_File: bye.gpr"
        echo "  Project_File: hello.gpr"
        ;;

    printenv)
        echo "export ALIRE_TEST_ENV=\"alire_was_here\""
        ;;
esac
