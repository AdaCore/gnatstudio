#!/bin/bash
# Fake 'alr' executable. Like the real one it refuses arguments it does not know
# about, leaving the offending command line in 'bad_command_line'; every accepted
# invocation is appended to 'alr_runs'.
#
# 'printenv' fails, after printing part of its output, for as long as the
# 'fail_printenv' file is there: that is how the driver exercises a setup whose
# last step fails.

cmd=""

for arg in "$@"; do
    case "$arg" in
        --non-interactive|--no-color|--no-tty|-q|--stop-after=generation) ;;
        build|show|printenv) cmd="$arg" ;;
        *)
            echo "unexpected argument: $arg" >&2
            printf 'alr %s\n' "$*" > bad_command_line
            exit 1
            ;;
    esac
done

echo "$cmd" >> alr_runs

case "$cmd" in
    build)
        echo "Synchronizing the crate..."
        ;;

    show)
        echo "  Name: hello"
        echo "  Project_File: bye.gpr"
        echo "  Project_File: hello.gpr"
        ;;

    printenv)
        # Print some of the environment before failing: a setup that gives up
        # half way through must undo what it has already applied. ALIRE is
        # exported by the real 'alr printenv' too.
        echo "export ALIRE=\"True\""
        echo "export ALIRE_TEST_ENV=\"alire_was_here\""

        if [ -f fail_printenv ]; then
            echo "ERROR: cannot generate the environment" >&2
            exit 1
        fi
        ;;
esac
