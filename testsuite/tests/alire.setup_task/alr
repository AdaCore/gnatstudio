#!/bin/bash
# Fake 'alr' executable, returning straight away: this test is about the
# sequence as a whole rather than about it not blocking. Like the real 'alr' it
# refuses arguments it does not know about, leaving the offending command line in
# 'bad_command_line'. Every accepted invocation is appended to 'alr_runs'.

cmd=""

for arg in "$@"; do
    case "$arg" in
        --non-interactive|--no-color|--no-tty|-q|--stop-after=generation) ;;
        build|show|printenv) cmd="$arg" ;;
        *)
            echo "unexpected argument: $arg" >&2
            printf 'alr %s\n' "$*" > bad_command_line
            exit 1
            ;;
    esac
done

echo "$cmd" >> alr_runs

case "$cmd" in
    build)
        echo "Synchronizing the crate..."
        ;;

    show)
        echo "  Name: hello"
        echo "  Project_File: bye.gpr"
        echo "  Project_File: hello.gpr"
        ;;

    printenv)
        # The real 'alr printenv' exports ALIRE itself, on top of the crate's
        # own variables.
        echo "export ALIRE=\"True\""
        echo "export ALIRE_TEST_ENV=\"alire_was_here\""
        ;;
esac
