#!/bin/bash
# Fake 'alr' executable: the real one needs the network and a toolchain. Like
# it, this one refuses arguments it does not know about, leaving the offending
# command line in 'bad_command_line' for the driver to report.
#
# 'build' does not return until the driver creates 'sync_may_finish', which can
# only happen if the main loop keeps running. Should the launch become
# synchronous again, nobody creates that file and 'sync_gave_up' is left behind,
# so the test reports the blocked main loop rather than something incidental.

cmd=""

for arg in "$@"; do
    case "$arg" in
        --non-interactive|--no-color|--no-tty|-q|--stop-after=generation) ;;
        build|show|printenv) cmd="$arg" ;;
        *)
            echo "unexpected argument: $arg" >&2
            printf 'alr %s\n' "$*" > bad_command_line
            exit 1
            ;;
    esac
done

case "$cmd" in
    build)
        echo "Synchronizing the crate..."
        touch sync_started

        # Give up after 30 seconds rather than hang the testsuite.
        for _ in $(seq 300); do
            if [ -f sync_may_finish ]; then
                echo "Build finished successfully."
                touch sync_finished
                exit 0
            fi
            sleep 0.1
        done

        echo "Timed out waiting for the test driver."
        touch sync_gave_up
        exit 1
        ;;

    show)
        echo "  Name: hello"
        echo "  Project_File: hello.gpr"
        ;;

    printenv)
        # The real 'alr printenv' exports ALIRE itself, on top of the crate's
        # own variables.
        echo "export ALIRE=\"True\""
        echo "export ALIRE_TEST_ENV=\"alire_was_here\""
        ;;
esac
